# MiniCodex accepts any OpenAI Chat Completions-compatible endpoint.
# MiniCodex 支持任意兼容 OpenAI Chat Completions 的服务地址。
MINICODEX_API_KEY=replace_with_your_api_key
MINICODEX_BASE_URL=https://api.deepseek.com
MINICODEX_MODEL=deepseek-chat

# Existing DeepSeek variable names remain supported.
# 原有的 DeepSeek 环境变量名称继续受支持。
# DEEPSEEK_API_KEY=replace_with_your_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Optional control-plane model overrides.
# 可选：为控制面与语义判断指定独立模型。
# DEEPSEEK_CONTROL_MODEL=deepseek-chat
# DEEPSEEK_JUDGE_MODEL=deepseek-chat
